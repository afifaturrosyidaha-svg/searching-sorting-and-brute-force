            for (int i = 0; i < panjang; i++)
            {
                langkah++;

                if (v[i] == nilaiCari)
                {
                    hasilDitemukan.Add(i);
    
                    SimpanLangkah(v, n,
                        kuning: new int[] { },
                        merah: new int[] { },
                        hijau: hasilDitemukan.ToArray(),
                        keterangan: $"Langkah ke-{langkah}: Memeriksa index {i} — {n[i]} ({v[i]}). DITEMUKAN! Nilai {nilaiCari} ada di index {i}. Brute Force tetap lanjut ke elemen berikutnya.");
                }
                else
                {
                    SimpanLangkah(v, n,
                        kuning: new int[] { i },
                        merah: new int[] { },
                        hijau: hasilDitemukan.ToArray(),
                        keterangan: $"Langkah ke-{langkah}: Memeriksa index {i} — {n[i]} ({v[i]}). {v[i]} ≠ {nilaiCari}, lanjut ke berikutnya.");
                }
            }

            string hasilAkhir = hasilDitemukan.Count > 0
                ? $"Brute Force Search selesai. Nilai {nilaiCari} DITEMUKAN di {hasilDitemukan.Count} tempat: index {string.Join(", ", hasilDitemukan)}. Total langkah: {langkah}."
                : $"Brute Force Search selesai. Nilai {nilaiCari} TIDAK DITEMUKAN. Total langkah: {langkah}.";

            SimpanLangkah(v, n,
                kuning: new int[] { },
                merah: new int[] { },
                hijau: hasilDitemukan.ToArray(),
                keterangan: hasilAkhir);

            lblPerbandingan.Text = $"Total Langkah Pencarian: {langkah}";
            lblPertukaran.Text = hasilDitemukan.Count > 0
                ? $"Ditemukan di index: {string.Join(", ", hasilDitemukan)}"
                : "Tidak ditemukan";

            currentStep = 0;
            TampilkanDataGrid(0);
        }


