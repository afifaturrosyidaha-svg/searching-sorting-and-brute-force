        private int[] hasilPerbandingan = new int[4];
        private int[] hasilPertukaran = new int[4];
        
        private void btnTabelPerbandingan_Click(object sender, EventArgs e)
        {
            dgvPerbandingan.Rows.Clear();
            string[] namaAlgoritma = { "Bubble Sort", "Selection Sort", "Insertion Sort", "Counting Sort" };

            for (int i = 0; i < 4; i++)
            {
                dgvPerbandingan.Rows.Add(namaAlgoritma[i], hasilPerbandingan[i], hasilPertukaran[i]);
            }

            
            int minPerbandingan = int.MaxValue;
            int minPertukaran = int.MaxValue;
            int idxMinPerb = 0, idxMinTukar = 0;

            for (int i = 0; i < 4; i++)
            {
                if (hasilPerbandingan[i] > 0 && hasilPerbandingan[i] < minPerbandingan)
                {
                    minPerbandingan = hasilPerbandingan[i];
                    idxMinPerb = i;
                }
                if (hasilPertukaran[i] < minPertukaran)
                {
                    minPertukaran = hasilPertukaran[i];
                    idxMinTukar = i;
                }
            }
            if (minPerbandingan != int.MaxValue)
                dgvPerbandingan.Rows[idxMinPerb].Cells[1].Style.BackColor = Color.LightGreen;
            if (minPertukaran != int.MaxValue)
                dgvPerbandingan.Rows[idxMinTukar].Cells[2].Style.BackColor = Color.LightGreen;
        }


        private void CatatHasilSorting(int indexAlgoritma, int perbandingan, int pertukaran)
        {
            hasilPerbandingan[indexAlgoritma] = perbandingan;
            hasilPertukaran[indexAlgoritma] = pertukaran;
        }

